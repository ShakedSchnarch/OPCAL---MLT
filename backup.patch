-def sha256_file(path: Path) -> str:
-    """Compute SHA‑256 hex digest of a file.
-
-    Parameters
-    ----------
-    path : Path
-        Path to the file to hash.
-    """
-
-    h = hashlib.sha256()
-    with path.open("rb") as f:
-        for chunk in iter(lambda: f.read(1024 * 1024), b""):
-            h.update(chunk)
-    return h.hexdigest()
