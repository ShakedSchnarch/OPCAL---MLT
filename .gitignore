# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
.venv.*/
.venv.*
venv/
env/
.opcal_venv/

# Distribution and build
build/
dist/
*.egg-info/
.eggs/

# OS files
.DS_Store
Thumbs.db

# IDE/editor settings
.vscode/
.idea/

# Logs and temp files
*.log
*.tmp
*.temp

# Jupyter and notebooks
.ipynb_checkpoints

# Test and coverage
.pytest_cache/
htmlcov/
.tox/
.coverage
.coverage.*
coverage.xml

# Type checking / lint caches
.mypy_cache/
.ruff_cache/

# Streamlit
.streamlit/*
!.streamlit/config.toml
# If you prefer to keep config and ignore only cache/secrets, comment the line above and use:
# .streamlit/cache/
# .streamlit/secrets.toml

# Example/output data
examples/__pycache__/
examples/*.csv
examples/*.npz
examples/*.hdf5

# User-specific configs
*.env
config.yaml

# Local helper/backup files
backup.patch
*.bak

# session artifacts
OPCAL_LABELS*/
Labeled signals*/
*.zip
